# Intervals.icu API Credentials
# Get these from https://intervals.icu/settings
INTERVALS_ICU_API_KEY=your_api_key_here
# Your athlete ID (e.g. i123456, shown in Settings on intervals.icu). Can also be set in the app.
INTERVALS_ICU_ATHLETE_ID=

# Hevy (optional, Hevy Pro): gym sessions also become Hevy routines. Get it at https://hevy.com/settings?developer
HEVY_API_KEY=

# LLM Providers (At least one recommended; can also be provided in-app)
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY is accepted as an alias for GEMINI_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local models, no key needed). Server-side only; the UI can't change the URL.
# Ollama's default context window is small: a long coach prompt plus tool schemas can be truncated silently.
# If the coach ignores instructions or never calls tools, start Ollama with OLLAMA_CONTEXT_LENGTH=16384 (or more).
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: only for an authenticating reverse proxy or ollama.com
OLLAMA_API_KEY=


# Session reports: the server checks Intervals.icu for completed planned workouts and writes a report for each one.
# Needs INTERVALS_ICU_API_KEY, INTERVALS_ICU_ATHLETE_ID and a key for the provider below. Set the minutes to 0 to turn it off.
REPORT_MODEL_PROVIDER=google
REPORT_MODEL_NAME=
REPORTS_POLL_MINUTES=10
# Lets a scheduler call GET /api/reports/poll (one poll) with `Authorization: Bearer <CRON_SECRET>`: the Vercel Cron Job
# in vercel.json, or a system timer. Unset = the route refuses every call. Where a cron calls it, set the minutes to 0.
CRON_SECRET=

# Database (Postgres). `make run` / `make dev` start it and set DATABASE_URL for the app themselves.
# For `pnpm dev` on the host, start it with `docker compose up -d db` and use:
DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence
# Optional, read by docker compose from `.env` (not `.env.local`):
# POSTGRES_PASSWORD=cadence
# POSTGRES_PORT=5432
# DEV_REPORTS_POLL_MINUTES=0
# DEV_PORT=3000
