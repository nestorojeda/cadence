# Intervals.icu API Credentials
# Get these from https://intervals.icu/settings
INTERVALS_ICU_API_KEY=your_api_key_here
INTERVALS_ICU_ATHLETE_ID=i435091

# Hevy (optional, Hevy Pro): gym sessions also become Hevy routines. Get it at https://hevy.com/settings?developer
HEVY_API_KEY=

# LLM Providers (At least one recommended; can also be provided in-app)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local models, no key needed). Server-side only; the UI can't change the URL.
# Ollama's default context window is small: a long coach prompt plus tool schemas can be truncated silently.
# If the coach ignores instructions or never calls tools, start Ollama with OLLAMA_CONTEXT_LENGTH=16384 (or more).
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: only for an authenticating reverse proxy or ollama.com
OLLAMA_API_KEY=

# Local MCP Bridge (Optional: set to "true" to route tools through python FastMCP server)
USE_LOCAL_MCP=false
MCP_SERVER_PATH=../intervals-icu-mcp
